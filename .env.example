# DataFlow ETL Studio configuration
# Copy this file to .env and adjust the values. Never commit the real .env file.
#   Windows (PowerShell):  Copy-Item .env.example .env

# --- Application metadata database (pipelines, run history, logs) ---------------
# SQLite (default, zero setup). Relative paths are resolved from the project folder.
DATAFLOW_DATABASE_URL=sqlite:///data/dataflow.db
# PostgreSQL example (the password is read from the URL - keep this file private):
# DATAFLOW_DATABASE_URL=postgresql+psycopg://dataflow:change-me@localhost:5432/dataflow

# --- Secret encryption key ------------------------------------------------------
# Fernet key used to encrypt API keys, tokens and database passwords at rest.
# Generate one with:  python -m src.cli generate-key
# If left empty, a key is generated on first start and stored in config/secret.key
# (that file is git-ignored). Losing the key makes saved secrets unreadable.
DATAFLOW_SECRET_KEY=

# --- Folders ----------------------------------------------------------------------
DATAFLOW_DATA_DIR=data
DATAFLOW_LOGS_DIR=logs

# --- Scheduling -------------------------------------------------------------------
# IANA time zone used for schedules, e.g. UTC, Asia/Kolkata, Europe/London
DATAFLOW_TIMEZONE=UTC
# true  = the Streamlit app runs the scheduler in-process (simple, single machine)
# false = run the separate worker:  python -m src.orchestration.worker
DATAFLOW_EMBEDDED_SCHEDULER=true
# A run is considered stuck (and its lock released) after this many minutes.
DATAFLOW_LOCK_TIMEOUT_MINUTES=120

# --- Outbound API security --------------------------------------------------------
# Comma-separated list of domains API sources may call. Empty = any public domain.
# Example: DATAFLOW_ALLOWED_DOMAINS=api.github.com,jsonplaceholder.typicode.com
DATAFLOW_ALLOWED_DOMAINS=
# Allow plain http:// API URLs (https is always allowed). Recommended: false
DATAFLOW_ALLOW_HTTP=false
# Use HTTP(S)_PROXY environment variables for API calls. When true, the per-connection
# IP check is performed by your proxy, not by DataFlow (URL checks still apply).
DATAFLOW_USE_ENV_PROXY=false

# --- Limits -----------------------------------------------------------------------
DATAFLOW_MAX_UPLOAD_MB=200
DATAFLOW_MAX_RESPONSE_MB=50

# --- Optional: PostgreSQL destination connection URL ------------------------------
# A PostgreSQL destination can read its full connection URL from an environment
# variable instead of storing a password. Name the variable in the destination form.
# WAREHOUSE_PG_URL=postgresql+psycopg://etl_user:change-me@localhost:5432/warehouse

# --- Optional: API secrets supplied via environment variables ---------------------
# An API source can read its key/token from an environment variable instead of the
# encrypted store. Name the variable in the source form.
# GITHUB_TOKEN=

# --- Docker Compose only -----------------------------------------------------------
# Password for the bundled PostgreSQL container (choose your own strong value).
POSTGRES_PASSWORD=
